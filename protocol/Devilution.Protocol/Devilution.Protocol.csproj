<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.82.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../devilution.proto" ProtoRoot=".." GrpcServices="None" Link="devilution.proto" />
    <Protobuf Include="../command_log.proto" ProtoRoot=".." GrpcServices="None" Link="command_log.proto" />
  </ItemGroup>
</Project>
