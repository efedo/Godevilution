{
  "formatVersion": 1,
  "id": "devilution.hellfire",
  "version": "0.1.0",
  "dependencies": ["devilution.base"],
  "schema": {
    "id": "devilution.diablo",
    "version": "0.88.0"
  },
  "dependencyConstraints": [
    {
      "id": "devilution.base",
      "minimumVersion": "0.1.0",
      "maximumVersion": "0.1.0"
    }
  ],
  "overlays": [
    {
      "table": "combat.tsv",
      "keys": ["base_attack_damage"],
      "mode": "upsert"
    },
    {
      "table": "monsters.tsv",
      "keys": ["entity_id"],
      "mode": "upsert"
    },
    {
      "table": "monster_types.tsv",
      "keys": ["monster_id"],
      "mode": "upsert"
    },
    {
      "table": "quest_types.tsv",
      "keys": ["quest_id"],
      "mode": "upsert"
    },
    {
      "table": "levels.tsv",
      "keys": ["level_id"],
      "mode": "upsert"
    },
    {
      "table": "items.tsv",
      "keys": ["item_id"],
      "mode": "upsert"
    },
    {
      "table": "unique_items.tsv",
      "keys": ["unique_id", "power"],
      "mode": "upsert"
    },
    {
      "table": "class_loadout_items.tsv",
      "keys": ["class_id", "item_order"],
      "mode": "upsert"
    }
  ]
}
